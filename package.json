{
    "name":  "files",
    "version":  "1.1.79",
    "description":  "",
    "main":  "main.js",
    "scripts":  {
                    "test":  "echo \"Error: no test specified\" \u0026\u0026 exit 1",
                    "start":  "electron .",
                    "package":  "node ./scripts/package-versioned.js",
                    "package-all":  "node ./scripts/package-all.js",
                    "package-mac":  "node ./scripts/package-mac.js",
                    "build-installer":  "node ./installer/build-installer.js",
                    "build-installer-all":  "node ./installer/build-installer.js --all",
                    "release":  "pwsh -NoProfile -File ./scripts/release.ps1",
                    "release-mac":  "bash scripts/release-mac.sh",
                    "deploy-chat":  "powershell -NoProfile -File ./server/deploy.ps1"
                },
    "keywords":  [

                 ],
    "author":  "",
    "license":  "ISC",
    "type":  "commonjs",
    "dependencies":  {
                         "express":  "^5.2.1",
                         "jszip":  "^3.10.1",
                         "minecraft-launcher-core":  "^3.18.2",
                         "yauzl":  "^2.10.0"
                     },
    "devDependencies":  {
                            "electron":  "^41.2.1",
                            "electron-builder":  "^24.13.3",
                            "electron-packager":  "^17.1.2",
                            "jimp":  "^1.6.1"
                        },
    "build":  {
                  "appId":  "com.cruxclient.launcher",
                  "productName":  "Crux Client",
                  "directories":  {
                                      "output":  "installer"
                                  },
                  "files":  [
                                "main.js",
                                "index.html",
                                "styles.css",
                                "package.json",
                                "update-window.ps1",
                                "node_modules/**/*",
                                "Crux-Client.png",
                                "cape_template.png",
                                "icons/**/*",
                                "!node_modules/jszip/dist/*.map"
                            ],
                  "win":  {
                              "icon":  "icons/icon.ico",
                              "signAndEditExecutable":  true,
                              "target":  [
                                             "nsis",
                                             "portable"
                                         ]
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "perMachine":  false,
                               "allowToChangeInstallationDirectory":  true,
                               "deleteAppDataOnUninstall":  true,
                               "createDesktopShortcut":  false,
                               "createStartMenuShortcut":  false,
                               "runAfterFinish":  true,
                               "shortcutName":  "Crux Client",
                               "artifactName":  "Crux-Client-Installer.exe",
                               "installerIcon":  "icons/icon.ico",
                               "uninstallerIcon":  "icons/icon.ico",
                               "include":  "installer/custom-shortcuts.nsh"
                           },
                  "portable":  {
                                   "artifactName":  "Crux-Client-Portable-x64.${ext}"
                               },
                  "linux":  {
                                "icon":  "icons/icon.png",
                                "target":  [
                                               "AppImage",
                                               "deb",
                                               "rpm",
                                               "zip",
                                               "tar.gz"
                                           ],
                                "artifactName":  "Crux-Client-Linux-x64.${ext}",
                                "category":  "Game",
                                "maintainer":  "Dev-Reds \u003cdev@norisk.gg\u003e",
                                "vendor":  "Dev-Reds",
                                "synopsis":  "Crux Client - Minecraft Launcher",
                                "description":  "Crux Client is a custom Minecraft launcher with mod management, profiles, and more."
                            },
                  "appImage":  {
                                   "artifactName":  "Crux-Client-Linux-x64.AppImage"
                               },
                  "deb":  {
                              "artifactName":  "Crux-Client-Linux-x64.deb",
                              "depends":  [
                                              "libgtk-3-0",
                                              "libnotify4",
                                              "libnss3",
                                              "libxss1",
                                              "libxtst6",
                                              "xdg-utils",
                                              "libatspi2.0-0",
                                              "libuuid1",
                                              "libappindicator3-1",
                                              "libsecret-1-0"
                                          ]
                          },
                  "rpm":  {
                              "artifactName":  "Crux-Client-Linux-x64.rpm",
                              "depends":  [
                                              "gtk3",
                                              "libnotify",
                                              "nss",
                                              "libXScrnSaver",
                                              "libxtst",
                                              "xdg-utils",
                                              "at-spi2-core",
                                              "libuuid",
                                              "libappindicator-gtk3",
                                              "libsecret"
                                          ]
                          },
                  "mac":  {
                              "icon":  "icons/icon.png",
                              "target":  [
                                             "dmg",
                                             "zip"
                                         ],
                              "artifactName":  "Crux-Client-Mac-x64.${ext}",
                              "category":  "public.app-category.games",
                              "hardenedRuntime":  true,
                              "gatekeeperAssess":  false,
                              "entitlements":  "build/entitlements.mac.plist",
                              "entitlementsInherit":  "build/entitlements.mac.plist"
                          },
                  "dmg":  {
                              "artifactName":  "Crux-Client-Mac-x64.dmg",
                              "contents":  [
                                               {
                                                   "x":  130,
                                                   "y":  220,
                                                   "type":  "file"
                                               },
                                               {
                                                   "x":  410,
                                                   "y":  220,
                                                   "type":  "link",
                                                   "path":  "/Applications"
                                               }
                                           ],
                              "window":  {
                                             "width":  540,
                                             "height":  380
                                         }
                          }
              }
}
